#!/bin/bash
#
# ccskill-gmail - Gmail Skill for Claude Code
#
# Usage: ccskill-gmail <command> [args...]
#

set -e

# Resolve CCSKILL_GMAIL_DIR from this script's location (follow symlinks)
SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
    LINK_TARGET=$(readlink "$SCRIPT_PATH")
    case "$LINK_TARGET" in
        /*) SCRIPT_PATH="$LINK_TARGET" ;;
        *)  SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$LINK_TARGET" ;;
    esac
done
CCSKILL_GMAIL_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
export CCSKILL_GMAIL_DIR

if [ -f "$CCSKILL_GMAIL_DIR/VERSION" ]; then
    VERSION=$(cat "$CCSKILL_GMAIL_DIR/VERSION")
else
    VERSION=$(cd "$CCSKILL_GMAIL_DIR" && git rev-parse --short HEAD 2>/dev/null || echo "unknown")
fi

show_help() {
    cat << EOF
ccskill-gmail - Gmail Skill for Claude Code

Usage: ccskill-gmail <command> [args...]

Commands:
  api <get|post|...> [args...]     Call the Gmail API (same as .ccskill-gmail/api)
  account <add|list|default|remove|update>  Manage registered Gmail accounts
  skill <install|uninstall>        Register as a user skill (all projects)
  bind <email|label> [DIR]         Pin a directory to an account (binding.json)
  unbind [DIR]                     Remove a directory binding
  migrate [--dry-run] [--yes]      Migrate legacy installs to central accounts
  setup                            One-time setup (clasp + symlink + skill + account)
  uninstall --all [--yes|--dry-run]  Remove ccskill-gmail from this machine (skill, accounts, CLI)
  install [--account NAME] [DIR]    (deprecated) Alias for 'bind'; --dedicated retired
  uninstall [DIR]                  Uninstall a legacy per-project install
  update [--force] [--yes] [DIR]   Update an installation
  update-all                       Update all installations
  apply-config [DIR]               Apply config.js changes to GAS
  register <PATH> [PATH...]        Register existing installations
  info [--json] [DIR]              Show details for current project
  status [--json] [--clean]        Show installation status
  history [list|clear] [args]      Show or clear operation history
  doctor [DIR]                     Diagnose environment and setup issues
  release [OUTPUT_DIR]             Create a distributable zip file
  help                             Show this help
  version                          Show version

Version: $VERSION
EOF

    # Master update check (cache only, no fetch)
    if [ -f "$CCSKILL_GMAIL_DIR/lib/update_check.sh" ]; then
        # shellcheck source=lib/update_check.sh
        . "$CCSKILL_GMAIL_DIR/lib/update_check.sh"
        local _uc_line
        _uc_line=$(update_check_format_oneline_cached "$CCSKILL_GMAIL_DIR" 2>/dev/null || true)
        if [ -n "$_uc_line" ]; then
            echo ""
            echo "$_uc_line"
        fi
    fi
}

# 管理コマンドの実行履歴を記録しつつ実行する (#135)
#   $1: 記録するか (true/false。false なら従来どおり exec)
#   $2: command 記録名   $3: subcommand 記録名 (無ければ "")
#   $4: "--"             $5+: 実際に実行するコマンドと引数
# 記録する引数 (args) はグローバル LOG_ARGS を用いる。
run_managed() {
    local do_record="$1"; shift
    local rec_cmd="$1"; shift
    local rec_sub="$1"; shift
    shift  # "--"

    if [ "$do_record" != true ]; then
        exec "$@"
    fi

    if [ -f "$CCSKILL_GMAIL_DIR/lib/history.sh" ]; then
        # shellcheck source=/dev/null
        source "$CCSKILL_GMAIL_DIR/lib/history.sh"
    fi

    local start_ms="" end_ms="" dur=""
    if command -v python3 &>/dev/null; then
        start_ms=$(python3 -c 'import time; print(int(time.time()*1000))' 2>/dev/null || echo "")
    fi

    set +e
    "$@"
    local code=$?
    set -e

    if command -v python3 &>/dev/null && [ -n "$start_ms" ]; then
        end_ms=$(python3 -c 'import time; print(int(time.time()*1000))' 2>/dev/null || echo "")
        [ -n "$end_ms" ] && dur=$(( end_ms - start_ms ))
    fi

    if type _ccskill_history_record_command &>/dev/null; then
        _ccskill_history_record_command "$rec_cmd" "$rec_sub" "$code" \
            "${CCSKILL_GMAIL_ACCOUNT:-}" "$dur" \
            ${LOG_ARGS[@]+"${LOG_ARGS[@]}"}
    fi
    exit "$code"
}

if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

COMMAND="$1"
shift

# 記録判定 (#135): 状態を変える管理コマンドのみ記録。読み取り専用は除外。
RECORD=false
REC_SUB=""
LOG_ARGS=("$@")
case "$COMMAND" in
    account)
        REC_SUB="${1:-}"
        case "$REC_SUB" in
            add|default|remove|update) RECORD=true ;;
            *) RECORD=false ;;   # list / "" / help は読み取り専用
        esac
        # args からサブコマンドを除く (subcommand フィールドに入るため)
        [ ${#LOG_ARGS[@]} -gt 0 ] && LOG_ARGS=("${LOG_ARGS[@]:1}")
        ;;
    skill)
        REC_SUB="${1:-}"
        case "$REC_SUB" in
            install|uninstall) RECORD=true ;;
            *) RECORD=false ;;
        esac
        [ ${#LOG_ARGS[@]} -gt 0 ] && LOG_ARGS=("${LOG_ARGS[@]:1}")
        ;;
    setup|install|uninstall|update|update-all|apply-config|bind|unbind|migrate)
        RECORD=true
        ;;
esac

case "$COMMAND" in
    api)
        exec "$CCSKILL_GMAIL_DIR/lib/api" "$@"
        ;;
    account)
        run_managed "$RECORD" account "$REC_SUB" -- "$CCSKILL_GMAIL_DIR/commands/account.sh" "$@"
        ;;
    skill)
        run_managed "$RECORD" skill "$REC_SUB" -- "$CCSKILL_GMAIL_DIR/commands/skill.sh" "$@"
        ;;
    bind)
        run_managed "$RECORD" bind "" -- "$CCSKILL_GMAIL_DIR/commands/bind.sh" bind "$@"
        ;;
    unbind)
        run_managed "$RECORD" unbind "" -- "$CCSKILL_GMAIL_DIR/commands/bind.sh" unbind "$@"
        ;;
    migrate)
        run_managed "$RECORD" migrate "" -- "$CCSKILL_GMAIL_DIR/commands/migrate.sh" "$@"
        ;;
    setup)
        run_managed "$RECORD" setup "" -- "$CCSKILL_GMAIL_DIR/commands/setup.sh" "$@"
        ;;
    install)
        run_managed "$RECORD" install "" -- "$CCSKILL_GMAIL_DIR/commands/install.sh" "$@"
        ;;
    uninstall)
        run_managed "$RECORD" uninstall "" -- "$CCSKILL_GMAIL_DIR/commands/uninstall.sh" "$@"
        ;;
    update)
        run_managed "$RECORD" update "" -- "$CCSKILL_GMAIL_DIR/commands/update.sh" "$@"
        ;;
    update-all)
        run_managed "$RECORD" update-all "" -- "$CCSKILL_GMAIL_DIR/commands/update-all.sh" "$@"
        ;;
    apply-config)
        run_managed "$RECORD" apply-config "" -- "$CCSKILL_GMAIL_DIR/commands/apply-config.sh" "$@"
        ;;
    register)
        exec "$CCSKILL_GMAIL_DIR/commands/register.sh" "$@"
        ;;
    info)
        exec "$CCSKILL_GMAIL_DIR/commands/info.sh" "$@"
        ;;
    status)
        exec "$CCSKILL_GMAIL_DIR/commands/status.sh" "$@"
        ;;
    history)
        exec "$CCSKILL_GMAIL_DIR/commands/history.sh" "$@"
        ;;
    doctor)
        exec "$CCSKILL_GMAIL_DIR/commands/doctor.sh" "$@"
        ;;
    release)
        exec "$CCSKILL_GMAIL_DIR/commands/release.sh" "$@"
        ;;
    help|--help|-h)
        show_help
        exit 0
        ;;
    version|--version|-v)
        echo "ccskill-gmail $VERSION"
        exit 0
        ;;
    # API サブコマンドの取り違え検知 (#120): api を付け忘れたケース
    get|post|download|save-html|save-pdf|whoami)
        echo "Error: '$COMMAND' is an api subcommand."
        echo ""
        echo "Did you mean:"
        echo "  ccskill-gmail api $COMMAND ..."
        exit 1
        ;;
    # API action の直打ち検知 (#120): action はサブコマンドではない
    search|get_thread|get_message|list_labels|get_unread_count|list_attachments|get_attachment|get_message_html|list_drafts|get_profile)
        echo "Error: '$COMMAND' is an API action, not a command."
        echo ""
        echo "Did you mean:"
        echo "  ccskill-gmail api get action=$COMMAND ..."
        exit 1
        ;;
    create_draft|create_reply_draft|update_draft|delete_draft|mark_read|mark_unread|add_label|remove_label|archive|move_to_inbox|move_to_trash|star|unstar|mark_important|unmark_important|bulk_mark_read|bulk_mark_unread|bulk_add_label|bulk_remove_label|bulk_archive)
        echo "Error: '$COMMAND' is an API action, not a command."
        echo ""
        echo "Did you mean:"
        echo "  ccskill-gmail api post '{\"action\":\"$COMMAND\",...}'"
        exit 1
        ;;
    *)
        echo "Error: Unknown command '$COMMAND'"
        echo ""
        show_help
        exit 1
        ;;
esac
